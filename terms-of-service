<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Terms of Service | Ace Gaming</title>
  <meta name="description" content="Terms of Service for Ace Gaming." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #06060d;
      --panel: #0f111c;
      --panel-2: #0b0d17;
      --muted: #9ea4b8;
      --line: rgba(255,255,255,.095);
      --pink: #ff3e9d;
      --blue: #27c7ff;
      --violet: #6848ff;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      min-height: 100vh;
      color: #fff;
      font-family: Inter, Arial, sans-serif;
      background:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px),
        radial-gradient(circle at 88% 5%, rgba(39,199,255,.09), transparent 24%),
        radial-gradient(circle at 8% 18%, rgba(255,62,157,.08), transparent 28%),
        var(--bg);
      background-size: 44px 44px, 44px 44px, auto, auto, auto;
    }
    a { color: inherit; text-decoration: none; }
    .legal-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(6,6,13,.86);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(18px);
    }
    .legal-nav {
      width: min(1180px, calc(100% - 32px));
      min-height: 74px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .legal-brand {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      font: 800 13px Orbitron, sans-serif;
      letter-spacing: .08em;
    }
    .legal-logo {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 11px;
      background: linear-gradient(135deg, rgba(255,62,157,.22), rgba(39,199,255,.16));
      color: #fff;
      font-size: 9px;
      box-shadow: 0 0 24px rgba(104,72,255,.18);
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0 15px;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: #d8dbe6;
      background: rgba(255,255,255,.02);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .04em;
      transition: .22s ease;
    }
    .back-link:hover {
      transform: translateY(-2px);
      color: #fff;
      border-color: rgba(39,199,255,.32);
    }
    .legal-shell {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      padding: 60px 0 90px;
      display: grid;
      grid-template-columns: 300px minmax(0, 1fr);
      align-items: start;
      gap: 24px;
    }
    .legal-side {
      position: sticky;
      top: 98px;
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: 24px;
      background:
        radial-gradient(circle at 88% 8%, rgba(104,72,255,.16), transparent 31%),
        rgba(15,17,28,.88);
      box-shadow: 0 24px 70px rgba(0,0,0,.22);
      backdrop-filter: blur(16px);
    }
    .side-icon {
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 15px;
      background: linear-gradient(135deg, rgba(255,62,157,.2), rgba(39,199,255,.14));
      color: #fff;
      font: 800 10px Orbitron, sans-serif;
    }
    .eyebrow {
      display: block;
      margin-top: 25px;
      color: #91ddff;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .18em;
    }
    h1 {
      margin-top: 11px;
      font: 700 clamp(32px, 4vw, 48px) / 1 Orbitron, sans-serif;
      letter-spacing: -.05em;
    }
    .side-intro {
      margin-top: 17px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.75;
    }
    .updated {
      display: inline-flex;
      margin-top: 20px;
      padding: 8px 10px;
      border: 1px solid rgba(39,199,255,.17);
      border-radius: 999px;
      color: #c7edf9;
      background: rgba(39,199,255,.055);
      font-size: 9px;
      font-weight: 700;
    }
    .legal-switch {
      display: grid;
      gap: 8px;
      margin-top: 24px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }
    .legal-switch a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 44px;
      padding: 0 13px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 12px;
      color: var(--muted);
      background: rgba(255,255,255,.018);
      font-size: 10px;
      font-weight: 700;
      transition: .22s ease;
    }
    .legal-switch a:hover,
    .legal-switch a.active {
      color: #fff;
      border-color: rgba(104,72,255,.35);
      background: linear-gradient(110deg, rgba(255,62,157,.08), rgba(39,199,255,.055));
    }
    .legal-switch a span { color: var(--blue); }
    .legal-document {
      min-width: 0;
      display: grid;
      gap: 14px;
    }
    .document-top {
      padding: 24px 26px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: rgba(15,17,28,.74);
    }
    .document-top p {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }
    .legal-section {
      position: relative;
      padding: clamp(26px, 4vw, 42px);
      border: 1px solid var(--line);
      border-radius: 22px;
      background: rgba(15,17,28,.82);
      box-shadow: 0 15px 45px rgba(0,0,0,.12);
      transition: border-color .25s ease, transform .25s ease;
      scroll-margin-top: 96px;
    }
    .legal-section:hover {
      transform: translateY(-2px);
      border-color: rgba(104,72,255,.28);
    }
    .legal-section::before {
      content: attr(data-index);
      position: absolute;
      right: 24px;
      top: 20px;
      color: rgba(255,255,255,.045);
      font: 800 36px Orbitron, sans-serif;
    }
    h2 {
      max-width: calc(100% - 60px);
      font: 700 clamp(19px, 2.4vw, 27px) Orbitron, sans-serif;
      letter-spacing: -.03em;
    }
    p, li {
      color: #c8cbd7;
      font-size: 13px;
      line-height: 1.85;
    }
    .legal-section p,
    .legal-section ul {
      margin-top: 15px;
    }
    ul { padding-left: 19px; }
    li + li { margin-top: 8px; }
    .contact-card {
      padding: 20px;
      border: 1px solid rgba(39,199,255,.18);
      border-radius: 16px;
      background: linear-gradient(120deg, rgba(255,62,157,.055), rgba(39,199,255,.05));
    }
    .contact-card a { color: #91ddff; font-weight: 800; }
    .notice {
      padding: 18px 20px;
      border: 1px dashed rgba(255,255,255,.12);
      border-radius: 16px;
      color: var(--muted);
      background: rgba(255,255,255,.018);
      font-size: 10px;
      line-height: 1.75;
    }
    .legal-footer {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      padding: 24px 0 38px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      color: var(--muted);
      font-size: 10px;
    }
    .legal-footer div { display: flex; gap: 9px; flex-wrap: wrap; }
    .legal-footer a {
      padding: 8px 10px;
      border: 1px solid rgba(255,255,255,.075);
      border-radius: 9px;
      color: #c9ccda;
      background: rgba(255,255,255,.018);
      transition: .2s ease;
    }
    .legal-footer a:hover { color: #fff; border-color: rgba(39,199,255,.28); }
    @media (max-width: 900px) {
      .legal-shell { grid-template-columns: 1fr; }
      .legal-side { position: static; }
      .legal-switch { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 620px) {
      .legal-nav { min-height: 66px; }
      .legal-brand { font-size: 11px; }
      .legal-logo { width: 34px; height: 34px; }
      .back-link { min-height: 38px; padding: 0 11px; }
      .legal-shell { padding: 30px 0 66px; }
      .legal-side { padding: 23px; border-radius: 20px; }
      .legal-switch { grid-template-columns: 1fr; }
      .legal-section { border-radius: 18px; }
      .legal-footer { align-items: flex-start; flex-direction: column; }
    }
</style>
</head>
